<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/screen_title_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:text="Search"
        android:padding="@dimen/spacing_standard"
        android:textSize="@dimen/txt_display"
        >
    </TextView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_resto_btn"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touchtarget_min"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:text="Add Restaurant"
        style="@style/ButtonOutlined"
        app:icon="@drawable/add_resto_ic"
        app:layout_constraintBottom_toBottomOf="@+id/screen_title_display"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/screen_title_display" />

<!--    <ImageView-->
<!--        android:id="@+id/add_resto_icon"-->
<!--        android:layout_width="@dimen/touchtarget_min"-->
<!--        android:layout_height="@dimen/touchtarget_min"-->
<!--        android:layout_marginEnd="@dimen/spacing_standard"-->
<!--        android:src="@drawable/add_resto_ic"-->
<!--        android:padding="@dimen/spacing_small"-->
<!--        app:layout_constraintBottom_toBottomOf="@+id/screen_title_display"-->
<!--        app:layout_constraintEnd_toEndOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="@+id/screen_title_display" />-->

    <androidx.appcompat.widget.SearchView
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_margin="@dimen/spacing_standard"
        android:background="@drawable/search_bar_bg"
        app:iconifiedByDefault="false"
        app:queryBackground="@android:color/transparent"
        android:queryHint="Search"
        app:hintTextColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@+id/filter_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screen_title_display" />

    <ImageView
        android:id="@+id/filter_icon"
        android:layout_width="@dimen/touchtarget_min"
        android:layout_height="@dimen/touchtarget_min"
        android:layout_marginEnd="16dp"
        android:padding="8dp"
        android:src="@drawable/filter_icon"
        app:layout_constraintBottom_toBottomOf="@+id/search_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/search_bar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_results_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_standard"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_standard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>
