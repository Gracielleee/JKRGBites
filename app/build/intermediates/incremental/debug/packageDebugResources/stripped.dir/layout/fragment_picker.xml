<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <View
        android:id="@+id/picker_app_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:background="@color/md_theme_primary"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btn_reset"
        android:layout_width="@dimen/touchtarget_min"
        android:layout_height="@dimen/touchtarget_min"
        android:contentDescription="@null"
        android:elevation="10dp"
        android:padding="11dp"
        app:srcCompat="@drawable/ic_reset"
        android:layout_marginStart="@dimen/spacing_standard"
        app:layout_constraintBottom_toBottomOf="@id/picker_app_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/picker_app_bar"
        app:tint="?attr/colorOnPrimary" />

    <TextView
        android:id="@+id/picker_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Picker      "
        android:textSize="@dimen/txt_headline"
        android:textColor="?attr/colorOnPrimary"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="@id/picker_app_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/picker_app_bar"
        app:layout_constraintVertical_bias="0.482" />

    <ImageView
        android:id="@+id/btn_shuffle"
        android:layout_width="@dimen/touchtarget_min"
        android:layout_height="@dimen/touchtarget_min"
        android:layout_marginEnd="4dp"
        android:contentDescription="@null"
        android:elevation="10dp"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="@id/picker_app_bar"
        app:layout_constraintEnd_toStartOf="@id/btn_undo"
        app:layout_constraintTop_toTopOf="@id/picker_app_bar"
        app:srcCompat="@drawable/ic_shuffle"
        app:tint="?attr/colorOnPrimary" />

    <ImageView
        android:id="@+id/btn_undo"
        android:layout_width="@dimen/touchtarget_min"
        android:layout_height="@dimen/touchtarget_min"
        android:contentDescription="@null"
        android:elevation="10dp"
        android:padding="10dp"
        android:layout_marginEnd="@dimen/spacing_standard"
        app:layout_constraintBottom_toBottomOf="@id/picker_app_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/picker_app_bar"
        app:srcCompat="@drawable/ic_undo"
        app:tint="?attr/colorOnPrimary" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/picker_card"
        android:layout_width="0dp"
        android:layout_height="500dp"
        android:layout_marginStart="@dimen/spacing_large"
        android:layout_marginEnd="@dimen/spacing_large"
        android:layout_marginBottom="@dimen/spacing_huge"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/picker_app_bar">

        <FrameLayout
            android:id="@+id/picker_card_flip_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

<!--            Front   -->
            <ImageView
                android:id="@+id/picker_card_front"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"
                tools:ignore="ContentDescription"
                android:visibility="gone"/>

<!--            Back               -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/picker_card_back_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/md_theme_surface"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large"
                    android:gravity="center"
                    android:translationY="-20dp">

                    <TextView
                        android:id="@+id/picker_card_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.01"
                        tools:text="Restaurant Name" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/md_theme_outlineVariant" />

                    <TextView
                        android:id="@+id/picker_card_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/md_theme_secondary"
                        android:textSize="@dimen/txt_headline"
                        android:alpha="0.9"
                        tools:text="Category: Italian, Seafood" />

                    <TextView
                        android:id="@+id/picker_card_cuisine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/md_theme_secondary"
                        android:textSize="@dimen/txt_headline"
                        android:alpha="0.9"
                        tools:text="Cuisine: Pizza, Pasta" />

                    <TextView
                        android:id="@+id/picker_card_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:textColor="@color/md_theme_tertiary"
                        android:textStyle="bold"
                        android:textSize="@dimen/txt_subheading"
                        tools:text="LEVEL: GROUND FLOOR" />

                    <TextView
                        android:id="@+id/picker_card_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/md_theme_secondary"
                        android:textSize="@dimen/txt_subheading"
                        android:alpha="1"
                        android:lineSpacingExtra="4dp"
                        tools:text="Tags: Vegetarian, Halal, Outdoor Seating" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/card_count_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/picker_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_large"
        android:textSize="@dimen/txt_display"
        android:textColor="@color/md_theme_primary"
        tools:text="30">

    </TextView>

    <TextView
        android:id="@+id/card_count_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="in deck"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="@dimen/txt_headline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_count_display"
        app:layout_constraintVertical_bias="0.1">

    </TextView>

</androidx.constraintlayout.widget.ConstraintLayout>
